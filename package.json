    "migrate:production": "wrangler d1 migrations apply jamula-family-coordinator --remote"
  },
  "dependencies": {
    "jose": "6.2.13"
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
