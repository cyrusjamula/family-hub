{
  "name": "jamula-family-coordinator",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "assets": "node scripts/build-assets.mjs",
    "build": "npm run assets && wrangler deploy --dry-run --outdir build",
